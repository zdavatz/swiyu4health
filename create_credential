#!/usr/bin/env bash
#
# create_credential — Issue a doctor credential and display a QR code for wallet scanning.
#
# Usage:
#   ./create_credential --first-name Hans --last-name Muster --gln 7601000000000
#
set -euo pipefail

# Defaults
FIRST_NAME=""
LAST_NAME=""
GLN=""
VALID_FROM=""
VALID_TILL=""
VALID_MONTH=false
VALID_YEAR=false
OFFER_VALIDITY=86400
CREDENTIAL_TYPE="doctor-credential"
ISSUER_URL="http://localhost:8080"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Issue a swiyu doctor credential and display a QR code for wallet scanning.

Required:
  --first-name NAME     First name of the credential subject
  --last-name  NAME     Last name of the credential subject
  --gln        GLN      GLN (Global Location Number) of the doctor

Optional:
  --valid-month         Valid from now for 1 month
  --valid-year          Valid from now for 1 year
  --valid-from DATE     Credential valid from (default: now)
  --valid-till DATE     Credential valid until (default: +1 year)
  --issuer-url URL      Issuer base URL (default: ${ISSUER_URL})
  -h, --help            Show this help message

If none of --valid-month, --valid-year, --valid-from, --valid-till are given,
the default is --valid-year.

Example:
  $(basename "$0") --first-name Hans --last-name Muster --gln 7601000000000 --valid-month
  $(basename "$0") --first-name Anna --last-name Beispiel --gln 7601000000001 --valid-year
  $(basename "$0") --first-name Anna --last-name Beispiel --gln 7601000000001 \\
      --valid-from 2026-06-01T00:00:00Z --valid-till 2028-01-01T00:00:00Z
EOF
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --first-name) FIRST_NAME="$2"; shift 2 ;;
        --last-name)  LAST_NAME="$2";  shift 2 ;;
        --gln)        GLN="$2";        shift 2 ;;
        --valid-month) VALID_MONTH=true; shift ;;
        --valid-year)  VALID_YEAR=true;  shift ;;
        --valid-from) VALID_FROM="$2"; shift 2 ;;
        --valid-till) VALID_TILL="$2"; shift 2 ;;
        --issuer-url) ISSUER_URL="$2"; shift 2 ;;
        -h|--help)    usage ;;
        *)
            echo "Error: Unknown option: $1" >&2
            echo "Run '$(basename "$0") --help' for usage." >&2
            exit 1
            ;;
    esac
done

# Validate required arguments
missing=()
[[ -z "$FIRST_NAME" ]] && missing+=("--first-name")
[[ -z "$LAST_NAME" ]]  && missing+=("--last-name")
[[ -z "$GLN" ]]        && missing+=("--gln")

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Error: Missing required arguments: ${missing[*]}" >&2
    echo "Run '$(basename "$0") --help' for usage." >&2
    exit 1
fi

# Compute validity dates
NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

if [[ "$VALID_MONTH" == true ]]; then
    VALID_FROM="$NOW"
    VALID_TILL=$(date -u -d "+1 month" +"%Y-%m-%dT%H:%M:%SZ")
elif [[ "$VALID_YEAR" == true ]]; then
    VALID_FROM="$NOW"
    VALID_TILL=$(date -u -d "+1 year" +"%Y-%m-%dT%H:%M:%SZ")
else
    # Default: if neither --valid-from nor --valid-till were set, use now + 1 year
    [[ -z "$VALID_FROM" ]] && VALID_FROM="$NOW"
    [[ -z "$VALID_TILL" ]] && VALID_TILL=$(date -u -d "+1 year" +"%Y-%m-%dT%H:%M:%SZ")
fi

# Check dependencies
for cmd in curl jq qrencode; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: '$cmd' is not installed." >&2
        exit 1
    fi
done

# Build JSON payload
payload=$(jq -n \
    --arg firstName "$FIRST_NAME" \
    --arg lastName  "$LAST_NAME" \
    --arg gln       "$GLN" \
    --arg validFrom "$VALID_FROM" \
    --arg validTill "$VALID_TILL" \
    --arg credType  "$CREDENTIAL_TYPE" \
    '{
        metadata_credential_supported_id: [$credType],
        credential_valid_from: $validFrom,
        credential_valid_until: $validTill,
        offer_validity_seconds: 86400,
        credential_subject_data: {
            firstName: $firstName,
            lastName: $lastName,
            gln: $gln
        }
    }')

# Call issuer API
echo "Issuing credential for ${FIRST_NAME} ${LAST_NAME} (GLN: ${GLN})..."
response=$(curl -s -w "\n%{http_code}" -X POST \
    "${ISSUER_URL}/management/api/credentials" \
    -H "Content-Type: application/json" \
    -d "$payload")

http_code=$(echo "$response" | tail -1)
body=$(echo "$response" | sed '$d')

if [[ "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    echo "Error: Issuer API returned HTTP ${http_code}" >&2
    echo "$body" >&2
    exit 1
fi

# Extract offer_deeplink
deeplink=$(echo "$body" | jq -r '.offer_deeplink // empty')

if [[ -z "$deeplink" ]]; then
    echo "Error: No offer_deeplink in response." >&2
    echo "Response: $body" >&2
    exit 1
fi

echo ""
echo "Credential offer created successfully."
echo ""
echo "Deeplink:"
echo "$deeplink"
echo ""
echo "QR Code (scan with swiyu wallet):"
echo ""
echo "$deeplink" | qrencode -t UTF8
